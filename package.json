    "workbox-precaching": "^7.3.0"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4"
  }
}
